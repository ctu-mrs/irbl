# one x500 with a 3D lidar; START_ARGS=<world>: cylinder_forest (default), forest, city, orchard, warehouse
TMUX_DIR=px4_sim_1_uav_3dlidar
# the domain the session itself uses (rosbag container joins it)
ROS_DOMAIN_ID=48
# the world (start.sh's argument): START_ARGS=city ../tmux.sh 1_uav_3dlidar (pane.sh passes it on)
PX4_GZ_WORLD_CLI=${START_ARGS:-${PX4_GZ_WORLD_CLI:-}}
