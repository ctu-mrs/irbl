# settings of every scenario (scenarios/<scenario>.env adds the scenario's own)

# docker compose project and tmux session / socket
SESSION_NAME=irbl_sim

IMAGE=smart-deployment:latest

# rendering (rviz2, Gazebo, the gz lidar / camera sensors):
#   dri:      host GPU through /dev/dri (Mesa: Intel / AMD). up.sh writes compose.gpu-dri.yaml with only
#             the Mesa-capable nodes: on hybrid laptops the NVIDIA ones make gz's GPU lidar (Ogre2) segfault
#   software: CPU rendering, works everywhere (use it if rviz2 says "OpenGL 3.3 is not supported")
#   nvidia:   NVIDIA GPU, needs nvidia-container-toolkit (see compose.gpu-nvidia.yaml)
# GPU=software
GPU=dri

# the compose files for docker compose (up.sh and the tmux panes run in this folder)
COMPOSE_FILE=compose.yaml:compose.gpu-${GPU:-dri}.yaml

# Gazebo window: empty = whatever the scenario does (as in ../../tmux), 1 = no window
# (scenarios with a launch: section in config/custom_config.yaml take HEADLESS from there)
HEADLESS=

# 1: no host display needed: Gazebo headless (Xvfb), no rviz2, Lichtblick in the browser on
# http://localhost:8080/?ds=foxglove-websocket&ds.url=ws://localhost:8765 (service viz).
# Sensor rendering is then on the CPU, the sim may run slower than real time.
WEB_VIZ=

# host variables passed on to the panes of the scenario's session (sim/pane.sh) when set, e.g.
# PLANNER=local ./tmux.sh ugv_uav_warehouse_dynamic
FORWARD_ENV="PX4_GZ_WORLD_CLI PLANNER PIN_CPUS N_PAIRS"
